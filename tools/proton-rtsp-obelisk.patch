diff --git a/dlls/mfplat/sample.c b/dlls/mfplat/sample.c
index 60d78dc..b58a453 100644
--- a/dlls/mfplat/sample.c
+++ b/dlls/mfplat/sample.c
@@ -1559,6 +1559,19 @@ static HRESULT sample_allocator_initialize(struct sample_allocator *allocator, u
     if (FAILED(hr = sample_allocator_get_surface_service(allocator, &service)))
         return hr;
 
+    if (service.d3d11_device)
+    {
+        UINT format_support = 0;
+
+        if (!dxgi_format || FAILED(ID3D11Device_CheckFormatSupport(service.d3d11_device, dxgi_format, &format_support))
+                || !(format_support & D3D11_FORMAT_SUPPORT_TEXTURE2D))
+        {
+            WARN("D3D11 device does not support format %u (support %#x).\n", dxgi_format, format_support);
+            sample_allocator_release_surface_service(allocator, &service);
+            return E_INVALIDARG;
+        }
+    }
+
     sample_allocator_release_samples(allocator);
 
     for (i = 0; i < sample_count; ++i)
