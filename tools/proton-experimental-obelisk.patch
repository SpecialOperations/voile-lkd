diff --git a/configure.ac b/configure.ac
index be6e92b..f602268 100644
--- a/configure.ac
+++ b/configure.ac
@@ -1082,6 +1082,22 @@ enable_winecoreaudio_drv=${enable_winecoreaudio_drv:-no}
 enable_wineandroid_drv=${enable_wineandroid_drv:-no}
 enable_winemac_drv=${enable_winemac_drv:-no}
 
+dnl Obelisk: the drivers of voile-lkd's Linux engine (wsd window server, Neptune) need Linux system calls
+case $host_os in
+  linux*) ;;
+  *)
+    enable_wineobeliskaudio_drv=${enable_wineobeliskaudio_drv:-no}
+    enable_nptunix=${enable_nptunix:-no}
+    enable_wineobelisk_drv=${enable_wineobelisk_drv:-no}
+    ;;
+esac
+
+dnl Obelisk: where ntdll's system call stubs go in its image (dlls/ntdll/Makefile.in): first on Linux hosts
+case $host_os in
+  linux*) AC_SUBST(NTDLL_SYSCALLS_FIRST,signal_x86_64.c) ;;
+  *) AC_SUBST(NTDLL_SYSCALLS_IN_ORDER,signal_x86_64.c) ;;
+esac
+
 dnl **** External libraries ****
 
 if test "x$with_system_dllpath" != "x" -a -n "$PE_ARCHS"
