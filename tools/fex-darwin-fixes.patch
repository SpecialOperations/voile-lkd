 // out of branch range go through their jump thunk (Arm64JITCore::ExitFunctionLink), and patch stubs stay in range
 // through the zones of CodeBuffer.
 static constexpr size_t MAX_CODE_SIZE = 1024 * 1024 * 512;
+#ifdef __APPLE__
+// Darwin port: MAP_JIT is demand-paged (zero physical RAM for untouched pages). Starting at MAX_CODE_SIZE avoids
+// geometric 16 -> 32 -> 64 -> 128 -> 256 MiB growth, which recompiled large games 4 times and left sleeping/idle
+// threads pinning all superseded CodeBuffers and their GuestToHostMaps indefinitely.
+static constexpr size_t INITIAL_CODE_SIZE = MAX_CODE_SIZE;
+#else
+static constexpr size_t INITIAL_CODE_SIZE = 1024 * 1024 * 16;
